extends ../layout/default.pug

block main
  - const statusLabels = { READY: "Sẵn sàng", STARTING: "Đang khởi động", RUNNING: "Đang hoạt động", STOPPING: "Đang dừng", STOPPED: "Đã dừng", ERROR: "Lỗi" }
  .dashboard
    .dashboard__header
      .dashboard__heading
        h1.dashboard__title Tổng quan hệ thống băng tải
        //p.dashboard__subtitle Quản lý băng tải, theo dõi kết quả và cấu hình vận hành

    if errorMessage
      .alert.alert--error
        | #{errorMessage}

    .conveyor-grid
      if conveyorList && conveyorList.length > 0
        each conveyor in conveyorList
          .card.conveyor-card
            .conveyor-card__head
              .conveyor-card__info
                h2 #{conveyor.name}
                if conveyor.user_name  
                  p Người vận hành: #{conveyor.user_name}
                else
                  p Chưa có người vận hành

              span.conveyor-status(class=conveyor.status)
                span.status-dot
                | #{statusLabels[conveyor.status] || "Sẵn sàng"}

            .conveyor-meta
              .conveyor-meta__item
                span Mã băng tải
                strong #{conveyor.conveyor_id}

              .conveyor-meta__item
                span Camera
                strong #{conveyor.camera_name || "-"}

              .conveyor-meta__item
                span Cổng kết nối
                strong #{conveyor.serial_port || "-"}

              .conveyor-meta__item
                span Tốc độ truyền
                strong #{conveyor.baud_rate || "-"}

              .conveyor-meta__item
                span Model AI
                strong #{conveyor.model_id || "-"}
              .conveyor-meta__item
                span Chế độ vận hành
                strong #{conveyor.config_mode || "-"}

            .conveyor-actions
              a.btn.btn--primary(href=`/inspection/monitor/${conveyor.conveyor_id}?mode=${conveyor.config_mode || "PRODUCTION"}`) Giám sát
              a.btn.btn--secondary(href=`/settings/${conveyor.conveyor_id}?tab=${conveyor.config_mode === "TEST" ? "test" : "production"}`) Cấu hình
      else
        .card
          .empty-state
            h3 Chưa có băng tải
            p Chưa có dữ liệu băng tải trong hệ thống.
