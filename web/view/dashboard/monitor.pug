extends ../layout/default.pug

block main
  - const statusLabels = { READY: "Sẵn sàng", STARTING: "Đang khởi động", RUNNING: "Đang chạy", STOPPING: "Đang dừng", STOPPED: "Đã dừng", STOP: "Đã dừng", ERROR: "Đang lỗi", OFFLINE: "Offline" }
  - const conveyorStatusText = statusLabels[String(conveyor.status || "").toUpperCase()] || "Đang chờ dữ liệu"
  - const currentMode = mode || "PRODUCTION"
  - const isTestMode = currentMode === "TEST"
  - const runningStatuses = ["STARTING", "RUNNING", "STOPPING"]
  - const isRunning = runningStatuses.includes(String(conveyor.status || "").toUpperCase())

  .dashboard(data-conveyor-code=conveyor.conveyor_id)
    .dashboard__header
      .dashboard__heading
        h1.dashboard__title #{conveyor.name}
        p.dashboard__subtitle= isTestMode ? "Giám sát kiểm thử model AI" : "Giám sát vận hành chính thức"

      .dashboard-actions
        a.btn.btn--secondary(href=dashboardUrl || "/dashboard") Quay lại
        a.btn.btn--primary(href=settingsUrl || `/settings/${conveyor.conveyor_id}`) Cấu hình

      .dashboard__status-pill(class=conveyor.status)
        span.status-dot
        span#systemStatusText #{conveyorStatusText}

    .inspection-layout
      .preview-panel.card
        .card__head.preview-panel__head
          div
            h2.card__title Ảnh kiểm tra
            p.card__desc Hiển thị ảnh đại diện của lượt kiểm tra mới nhất
          .preview-frame-meta
            span Khung hình
            strong#framePreviewScore -

        .main-preview
          .main-preview__label Ảnh khoanh vùng lỗi
          .main-preview__image
            img#overlayPreviewImage(src="" alt="Ảnh khoanh vùng lỗi")
            .image-placeholder Chưa có ảnh khoanh vùng lỗi

        .thumb-grid.thumb-grid--one
          .thumb-box
            .thumb-box__title Ảnh sản phẩm
            .thumb-box__image
              img#roiPreviewImage(src="" alt="Ảnh sản phẩm")
              .image-placeholder Chưa có ảnh sản phẩm

      .side-panel
        .card.control-card
          .card__head
            h2.card__title Phiên kiểm tra

          .btn-row
            button.btn.btn--success(type="button" onclick="sendControlCommand('START_SYSTEM')") Bắt đầu
            button.btn.btn--danger(type="button" onclick="sendControlCommand('STOP_SYSTEM')") Kết thúc
            button.btn.btn--secondary(type="button" onclick="sendControlCommand('GET_STATUS')") Trạng thái

          .control-ack-box
            p#lastControlAck Chưa có phản hồi từ hệ thống

        .result-card.card
          .card__head
            h2.card__title Kết quả kiểm tra
            p.card__desc Kết quả mới nhất từ hệ thống kiểm tra

          .result-main
            span#resultLabel.result-badge -

          .inspection-summary
            .summary-row
              span.summary-label Mã lượt kiểm tra
              span#stt.summary-value -
              span#jobId.summary-value(style="display:none") -

            .summary-row
              span.summary-label Kết quả khung hình
              span#framePreviewLabel.summary-value -

            .summary-row
              span.summary-label Thời gian
              span#resultTimestamp.summary-value -

        .card
          .card__head
            h2.card__title Trạng thái hệ thống
            p.card__desc Kết nối máy chủ, bộ điều khiển và hệ thống kiểm tra

          .system-status
            span.system-status__label Kết nối điều khiển
            span#systemStatus.system-status__value
              span.status-dot
              | Chưa kết nối

          .system-status
            span.system-status__label Trạng thái băng tải
            span#aiStatus.system-status__value(class=conveyor.status)
              span.status-dot
              | #{conveyorStatusText}

          .system-status
            span.system-status__label Phiên kiểm tra AI
            span#inspectionSessionStatus.system-status__value
              span.status-dot
              | Chưa bắt đầu

          .system-status
            span.system-status__label Máy chủ WEB
            span.system-status__value.connected
              span.status-dot
              | Đang chạy

  script.
    window.__CONVEYOR_ID__ = !{JSON.stringify(conveyor.conveyor_id || "")};
    window.__RUNTIME_MODE__ = !{JSON.stringify(mode  || "PRODUCTION")};
    window.__CONVEYOR_STATUS__ = !{JSON.stringify(conveyor.status || null)};
    window.__LATEST_INSPECTION__ = !{JSON.stringify(latestInspection || null)};

  if isTestMode
    #modelApprovalModal.modal.fade(tabindex="-1" role="dialog" aria-labelledby="modelApprovalModalTitle" aria-hidden="true")
      .modal-dialog.modal-dialog-centered(role="document")
        .modal-content
          .modal-header
            h5#modelApprovalModalTitle.modal-title Thông báo
            button.close(type="button" data-dismiss="modal" aria-label="Đóng")
              span(aria-hidden="true") &times;
          .modal-body
            p Phê duyệt model AI #{selectedModel ? selectedModel.model_name : "-"}
            form.btn-row(method="POST" action=`/settings/${conveyor.conveyor_id}/approve-model`)
              button.btn.btn--success(
                type="submit"
                name="decision"
                value="PASS"
              ) Đạt

              button.btn.btn--danger(
                type="submit"
                name="decision"
                value="FAIL"
              ) Không đạt
