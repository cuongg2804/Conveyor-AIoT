extend ../layout/default.pug 
block main
    .page 
        .dashboard_header
            .dashboard_heading
                h1.dashboard_title Quản lý camera
                p.dashboard_subtitle Cập nhật thông tin camera
            .dashboard_actions
                a.btn.btn--secondary(href="/cameras") Quay lại
        if error
            .alert.alert--error #{error}
        if updated
            .alert.alert--success Cập nhật thành công.
        
        .card.camera-form-card
            form.settings-form(method="POST" action=`/cameras/edit/${camera.camera_id}`)
                .field
                    label.field__label Mã camera
                    input.field__control(type="text" value=camera.camera_id disabled)
                .field 
                    label.field__label Tên camera
                    input.field__control(type="text" name="camera_name" value=camera.camera_name required)
                .camera-picker(data-camera-picker data-selected-ip=camera.camera_ip)
                    .camera-picker__head
                        div
                            h3.camera-picker__title Camera kết nối
                            p.camera-picker__desc Quét để kiểm tra hoặc chọn camera khác.
                        button.btn.btn--secondary(type="button" data-camera-scan-button) Quét camera
                    p.camera-picker__status(data-camera-scan-status) Đang sử dụng: #{camera.camera_ip || "Chưa chọn camera"}.
                    .camera-picker__grid(data-camera-scan-results)

                .field.camera-ip-field
                    label.field__label(for="camera_ip") Địa chỉ camera đã chọn
                    input#camera_ip.field__control(type="text" name="camera_ip" value=camera.camera_ip required readonly placeholder="Chưa chọn camera")
                .field
                    label.field__label(for="status") Trạng thái
                    - const statusLabels = { AVAILABLE: "Sẵn sàng", IN_USE: "Đang vận hành", ERROR: "Lỗi" }
                    input#status.field__control(
                        type="text"
                        value=statusLabels[camera.status] || "-"
                        disabled
                        )

                .field
                    label.field__label(for="description") Mô tả
                    input#description.field__control(type="text" name="description" value=camera.description)
                .settings-actions
                    button.btn.btn--primary(type="submit") Cập nhật camera
