extend ../layout/default.pug

block main
  .page
    .dashboard__header
      .dashboard__heading
        h1.dashboard__title Quản lý model AI
        p.dashboard__subtitle Upload file model .ckpt hoặc .onnx lên MinIO để lưu trữ model

    .model-upload-layout
      .card
        .card__head
          h2.card__title Upload model package
          p.card__desc Chọn model .ckpt/.onnx và model_info.json.

        form.model-upload-form(method="POST" action="/models/upload" enctype="multipart/form-data")
          .field
            label.field__label(for="model") File model
            input#model.field__control(type="file" name="model" accept=".ckpt,.onnx" required)

          .field
            label.field__label(for="metadata") File metadata
            input#metadata.field__control(type="file" name="metadata" accept=".json,application/json" required)

          .model-upload-meta
            span Bucket: #{process.env.MINIO_MODEL_BUCKET || process.env.MINIO_BUCKET || "ai-models"}
            span Giới hạn: #{maxUploadMb} MB
            span Trạng thái ban đầu: testing

          .btn-row
            button.btn.btn--primary(type="submit") Upload model

      .card
        .card__head
          h2.card__title Kết quả upload
          p.card__desc Thông tin object sau khi upload thành công.

        if uploadedModel
          .upload-result
            .upload-result__row
              span Bucket
              strong= uploadedModel.bucket
            .upload-result__row
              span Model ID
              strong= uploadedModel.model_id
            .upload-result__row
              span Registry ID
              strong= uploadedModel.registry_id
            .upload-result__row
              span Object key
              strong= uploadedModel.object_key
            .upload-result__row
              span Model
              strong #{uploadedModel.product_code} / #{uploadedModel.model_name} / #{uploadedModel.version}
            .upload-result__row
              span Format
              strong= uploadedModel.model_format || (uploadedModel.object_key || "").split(".").pop()
            .upload-result__row
              span Threshold
              strong= uploadedModel.threshold
            .upload-result__row
              span Trạng thái
              strong= uploadedModel.status
            .upload-result__row
              span Tên file
              strong= uploadedModel.originalName
            .upload-result__row
              span Dung lượng
              strong #{uploadedModel.size ? (uploadedModel.size / 1024 / 1024).toFixed(2) : 0} MB
        else
          .empty-state
            h3 Chưa có model được upload
            p Sau khi upload thành công, thông tin file sẽ hiển thị tại đây.

    .card.model-list-card
      .card__head
        h2.card__title Model Registry
        p.card__desc Danh sách model đã lưu trong MongoDB và checkpoint trên MinIO.

      if models && models.length > 0
        .table-wrap
          table.table
            thead
              tr
                //th Model ID
                th Product
                th Model
                th Version
                th Format
                th Threshold
                th Trạng thái
                //- th Object key
                th Thao tác
            tbody
              each item in models
                tr
                  //td= item.model_id
                  td= item.product_code
                  td= item.model_name
                  td= item.version
                  td= item.model_format || (item.object_key || "").split(".").pop()
                  td= item.threshold
                  td= item.status
                  //- td
                  //-   span.model-object-key= item.object_key
                  td
                    .table-actions
                      a.btn.btn--secondary.btn--sm(href=`/models/${item.model_id}/edit`) Sửa
                      form(method="POST" action=`/models/${item.model_id}/delete`)
                        button.btn.btn--danger.btn--sm(
                          type="submit"
                          onclick="return confirm('Bạn có chắc muốn xóa model này không?');"
                        ) Xóa
      else
        .empty-state
          h3 Chưa có model trong registry
          p Upload checkpoint và metadata để tạo model đầu tiên.

block scripts
  if error
    script.
      Toastify({
        text: "#{error}",
        duration: 3000,
        gravity: "top",
        position: "right",
        backgroundColor: "#ef4444",
        close: true
      }).showToast();

  if success
    script.
      Toastify({
        text: "#{success}",
        duration: 3000,
        gravity: "top",
        position: "left",
        backgroundColor: "#16a34a",
        close: true
      }).showToast();
